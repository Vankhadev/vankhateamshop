{
  "provider": {
    "tiemai": {
      "type": "openai",
      "options": {
        "baseURL": "https://tiemai.io.vn/v1",
        "apiKey": "YOUR_API_KEY"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "contextWindow": 200000,
          "maxTokens": 8192
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "contextWindow": 128000,
          "maxTokens": 16384
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "contextWindow": 200000,
          "maxTokens": 32768
        },
        "claude-opus-5.5": {
          "name": "Claude Opus 5.5",
          "contextWindow": 200000,
          "maxTokens": 8192
        }
      }
    }
  },
  "defaultProvider": "tiemai",
  "defaultModel": "claude-sonnet-5"
}
