# ============================================================
# TiemAI Gateway - Biến môi trường cho tất cả AI Agents
# Copy file này thành .env và thay YOUR_API_KEY bằng key thật
# ============================================================

# API Key từ TiemAI.io.vn
TIEMAI_API_KEY=YOUR_API_KEY

# Base URLs
TIEMAI_BASE_URL=https://tiemai.io.vn
TIEMAI_API_BASE=https://tiemai.io.vn/v1

# OpenAI Compatible (dùng cho Codex, Cursor, Continue, Cline, Kilo, Windsurf)
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_BASE_URL=https://tiemai.io.vn/v1

# Anthropic (dùng cho Claude Code)
ANTHROPIC_BASE_URL=https://tiemai.io.vn
ANTHROPIC_AUTH_TOKEN=YOUR_API_KEY
ANTHROPIC_API_KEY=YOUR_API_KEY
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Google Gemini CLI
GOOGLE_GEMINI_BASE_URL=https://tiemai.io.vn
GEMINI_API_KEY=YOUR_API_KEY

# DeepSeek / CodeWhale
DEEPSEEK_API_KEY=YOUR_API_KEY
CODEWHALE_BASE_URL=https://tiemai.io.vn/v1

# Model mặc định
DEFAULT_MODEL=claude-sonnet-5
